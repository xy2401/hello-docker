{
  "name": "hello-docker",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "容器基础与生态手册、公共 Docker 脚本和 Actions 验证证据",
  "engines": { "node": "^20.19.0 || >=22.16.0" },
  "bin": { "hello-docker": "bin/hello-docker.mjs" },
  "scripts": {
    "docs:dev": "vitepress dev docs --host 127.0.0.1 --port 24045 --strictPort",
    "docs:build": "node scripts/build-catalog.mjs && vitepress build docs",
    "docs:preview": "vitepress preview docs --host 127.0.0.1 --port 24045 --strictPort",
    "docker:plan": "node bin/hello-docker.mjs plan --manifest scenarios/container-basics.json",
    "software:plan": "node bin/software-capture.mjs plan",
    "test:software": "node --test tests/software.test.mjs && python3 tests/software-inventory.test.py",
    "check:manifests": "node scripts/check-project.mjs",
    "test": "node --test tests/*.test.mjs",
    "check": "npm run check:manifests && npm test"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "vite": "6.4.3",
    "vitepress": "1.6.4",
    "vue": "^3.4.0"
  },
  "overrides": { "vite": "6.4.3" }
}
