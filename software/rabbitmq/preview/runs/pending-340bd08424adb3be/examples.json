{
  "schemaVersion": 1,
  "captureId": "pending-340bd08424adb3be",
  "product": {
    "id": "rabbitmq",
    "name": "RabbitMQ",
    "version": "4.1.4 / Erlang 27.3.4.3"
  },
  "examples": [
    {
      "id": "version",
      "title": "版本",
      "notes": [
        "RabbitMQ 4.1.4 与既有 ERTS 15.2.7.2 对应的 Erlang 27.3.4.3；Erlang 命令归依赖。"
      ],
      "steps": [
        {
          "id": "version",
          "argv": [
            "rabbitmqctl",
            "version"
          ],
          "assertions": [
            {
              "stream": "exitCode",
              "op": "equals",
              "value": 0
            },
            {
              "stream": "stdout",
              "op": "includes",
              "value": "4.1.4"
            }
          ],
          "cwd": "/work",
          "stdin": null,
          "status": "not-run",
          "stdout": null,
          "stderr": null,
          "exitCode": null
        }
      ],
      "status": "not-run"
    },
    {
      "id": "status",
      "title": "节点状态",
      "notes": [
        "单节点、隔离网络，不连接已有集群。"
      ],
      "steps": [
        {
          "id": "ping",
          "argv": [
            "rabbitmq-diagnostics",
            "-q",
            "ping"
          ],
          "assertions": [
            {
              "stream": "exitCode",
              "op": "equals",
              "value": 0
            },
            {
              "stream": "stdout",
              "op": "includes",
              "value": "Ping succeeded"
            }
          ],
          "cwd": "/work",
          "stdin": null,
          "status": "not-run",
          "stdout": null,
          "stderr": null,
          "exitCode": null
        },
        {
          "id": "running",
          "argv": [
            "rabbitmq-diagnostics",
            "-q",
            "check_running"
          ],
          "assertions": [
            {
              "stream": "exitCode",
              "op": "equals",
              "value": 0
            },
            {
              "stream": "stdout",
              "op": "includes",
              "value": "fully booted"
            }
          ],
          "cwd": "/work",
          "stdin": null,
          "status": "not-run",
          "stdout": null,
          "stderr": null,
          "exitCode": null
        },
        {
          "id": "status",
          "argv": [
            "rabbitmqctl",
            "status"
          ],
          "assertions": [
            {
              "stream": "exitCode",
              "op": "equals",
              "value": 0
            },
            {
              "stream": "stdout",
              "op": "includes",
              "value": "4.1.4"
            }
          ],
          "cwd": "/work",
          "stdin": null,
          "status": "not-run",
          "stdout": null,
          "stderr": null,
          "exitCode": null
        }
      ],
      "status": "not-run"
    },
