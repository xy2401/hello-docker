{
  "schemaVersion": 1,
  "product": {
    "id": "mongodb",
    "name": "MongoDB",
    "version": "9.0.4"
  },
  "platform": "linux/amd64",
  "base": {
    "image": "ubuntu:26.04@sha256:42527649dbc4f9197a6073f426f488cbff0e9cc9f2afce32d91c383e4875634a",
    "source": "https://hub.docker.com/_/ubuntu",
    "indexDigest": "sha256:c098726dd9b9733f3e885f8de0ef375206a311b0a317eadc40d347b1115fb944"
  },
  "collector": {
    "id": "collector-python",
    "version": "3.13.9+20251014",
    "url": "https://github.com/astral-sh/python-build-standalone/releases/download/20251014/cpython-3.13.9%2B20251014-x86_64-unknown-linux-gnu-install_only.tar.gz",
    "sha256": "b4b0204658930337c85c321b49ed2585fe544097a72bc76dcf0b77e49fff8473",
    "strip": 0
  },
  "dependencies": {
    "packages": [
      "ca-certificates",
      "libcurl4t64",
      "libgssapi-krb5-2",
      "libldap2",
      "libssl3t64",
      "liblzma5",
      "libzstd1",
      "zlib1g",
      "libsnappy1v5"
    ],
    "artifacts": []
  },
  "artifacts": [
    {
      "id": "mongodb-server",
      "version": "9.0.4",
      "url": "https://fastdl.mongodb.org/linux/mongodb-linux-x86_64-ubuntu2604-9.0.4.tgz",
      "sha256": "b11e8183acad92f776b8bb5a22e1c6cb27b47246fce0f9e22342ed42bcdf2229",
      "destination": "/opt/mongodb",
      "strip": 1
    },
    {
      "id": "mongosh",
      "version": "2.12.0",
      "url": "https://github.com/mongodb-js/mongosh/releases/download/v2.12.0/mongosh-2.12.0-linux-x64.tgz",
      "sha256": "aa42cb826b7b8e655c5481293f5365ddaf1a23e43af07520326e5bbc957838ad",
      "destination": "/opt/mongosh",
      "strip": 1
    },
    {
      "id": "database-tools",
      "version": "100.19.1",
      "url": "https://fastdl.mongodb.org/tools/db/mongodb-database-tools-ubuntu2604-x86_64-100.19.1.tgz",
      "sha256": "1913e492316f71869cd8149ec6b1491558b04c647ebee40c191ef97f6c899324",
      "destination": "/opt/database-tools",
      "strip": 1
    }
  ],
  "environment": {
    "PATH": "/opt/mongodb/bin:/opt/mongosh/bin:/opt/database-tools/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin",
    "HOME": "/work"
  },
  "commandRoots": [
    "/opt/mongodb/bin",
    "/opt/mongosh/bin",
    "/opt/database-tools/bin"
  ],
  "commandNotes": {
    "mongod": {
      "purpose": "启动 MongoDB 数据库服务。",
      "category": "服务"
    },
    "mongos": {
      "purpose": "启动分片集群路由。",
      "category": "服务"
    },
    "mongosh": {
      "purpose": "运行 MongoDB Shell 查询与管理表达式。",
      "category": "交互"
    },
    "mongoexport": {
      "purpose": "导出集合为 JSON 或 CSV。",
      "category": "导入导出"
    },
    "mongoimport": {
      "purpose": "将 JSON 或 CSV 导入集合。",
      "category": "导入导出"
    },
    "mongodump": {
      "purpose": "生成数据库 BSON 备份。",
      "category": "备份恢复"
    },
    "mongorestore": {
      "purpose": "从 BSON 备份恢复数据库。",
      "category": "备份恢复"
    }
  },
  "prepare": "mkdir -p /work/db\nmongod --dbpath /work/db --logpath /work/mongod.log --fork --bind_ip 127.0.0.1 --port 27017\nfor i in $(seq 1 30); do mongosh --quiet --eval 'quit(db.runCommand({ping:1}).ok === 1 ? 0 : 1)' && break; sleep 1; done\nmongosh --quiet capture --eval 'db.seed.drop(); db.seed.insertMany([{_id:1,name:\"alpha\",score:10},{_id:2,name:\"beta\",score:20},{_id:3,name:\"gamma\",score:30}])'\n",
  "examples": [
    {
      "id": "version",
      "title": "版本",
      "notes": [
        "服务端 9.0.4；Shell 和 Database Tools 分别固定版本，和历史 7/8 结果分开。"
      ],
      "steps": [
        {
          "id": "server-version",
          "argv": [
            "mongod",
            "--version"
          ],
          "assertions": [
            {
              "stream": "exitCode",
              "op": "equals",
              "value": 0
            },
            {
              "stream": "stdout",
              "op": "includes",
              "value": "9.0.4"
            }
          ]
        },
        {
          "id": "shell-version",
          "argv": [
            "mongosh",
            "--version"
          ],
          "assertions": [
            {
              "stream": "exitCode",
              "op": "equals",
              "value": 0
            },
            {
              "stream": "stdout",
              "op": "includes",
              "value": "2.12.0"
            }
          ]
        }
      ]
    },
    {
      "id": "ping",
      "title": "连接检查",
      "notes": [
        "只连接本次隔离容器的本地服务。"
      ],
      "steps": [
        {
          "id": "ping",
          "argv": [
            "mongosh",
            "--quiet",
            "--eval",
            "print(JSON.stringify(db.runCommand({ping:1})))"
          ],
          "assertions": [
            {
              "stream": "exitCode",
              "op": "equals",
              "value": 0
            },
            {
              "stream": "stdout",
              "op": "includes",
              "value": "\"ok\":1"
            }
          ],
          "format": "json"
        }
      ]
    },
    {
      "id": "collection",
      "title": "临时集合增查",
      "notes": [
        "只操作 capture 临时数据库，不导入或修改既有 MFlix 快照。"
      ],
      "steps": [
        {
          "id": "insert-find",
          "argv": [
            "mongosh",
            "--quiet",
            "capture",
            "--eval",
            "db.demo.drop(); db.demo.insertMany([{_id:1,name:'alpha',score:10},{_id:2,name:'beta',score:20}]); print(JSON.stringify(db.demo.find({score:{$gte:15}}).toArray()))"
          ],
          "assertions": [
            {
              "stream": "exitCode",
              "op": "equals",
              "value": 0
            },
            {
              "stream": "stdout",
              "op": "includes",
              "value": "beta"
            }
          ],
          "format": "json"
        }
      ]
    },
    {
      "id": "export-import",
      "title": "导出与导入",
      "notes": [
        "独立使用 seed 集合，目标为本次运行的 imported 集合。"
      ],
      "steps": [
        {
          "id": "export",
          "argv": [
            "mongoexport",
            "--db=capture",
            "--collection=seed",
            "--out=/work/seed.json",
            "--jsonArray"
          ],
          "assertions": [
            {
              "stream": "exitCode",
              "op": "equals",
              "value": 0
            }
          ]
        },
        {
          "id": "import",
          "argv": [
            "mongoimport",
            "--db=capture",
            "--collection=imported",
            "--drop",
            "--file=/work/seed.json",
            "--jsonArray"
          ],
          "assertions": [
            {
              "stream": "exitCode",
              "op": "equals",
              "value": 0
            }
          ]
        },
        {
          "id": "verify",
          "argv": [
            "mongosh",
            "--quiet",
            "capture",
            "--eval",
            "print(JSON.stringify({count:db.imported.countDocuments({})}))"
          ],
          "assertions": [
            {
              "stream": "exitCode",
              "op": "equals",
              "value": 0
            },
            {
              "stream": "stdout",
              "op": "includes",
              "value": "\"count\":3"
            }
          ],
          "format": "json"
        }
      ]
    },
    {
      "id": "dump-restore",
      "title": "备份与恢复",
      "notes": [
        "从 seed 备份到 /work，再恢复为 restored；不接触外部服务。"
      ],
      "steps": [
        {
          "id": "dump",
          "argv": [
            "mongodump",
            "--db=capture",
            "--collection=seed",
            "--out=/work/dump"
          ],
          "assertions": [
            {
              "stream": "exitCode",
              "op": "equals",
              "value": 0
            }
          ]
        },
        {
          "id": "restore",
          "argv": [
            "mongorestore",
            "--drop",
            "--nsInclude=capture.seed",
            "--nsFrom=capture.seed",
            "--nsTo=capture.restored",
            "/work/dump"
          ],
          "assertions": [
            {
              "stream": "exitCode",
              "op": "equals",
              "value": 0
            }
          ]
        },
        {
          "id": "verify",
          "argv": [
            "mongosh",
            "--quiet",
            "capture",
            "--eval",
            "print(JSON.stringify({count:db.restored.countDocuments({})}))"
          ],
          "assertions": [
            {
              "stream": "exitCode",
              "op": "equals",
              "value": 0
            },
            {
              "stream": "stdout",
              "op": "includes",
              "value": "\"count\":3"
            }
          ],
          "format": "json"
        }
      ]
    }
  ]
}
