  "examples": [
    {
      "id": "version",
      "title": "版本",
      "notes": [
        "发行包固定为 Temurin 25.0.3+9；不把系统工具列入 JDK。"
      ],
      "steps": [
        {
          "id": "java-version",
          "argv": [
            "java",
            "--version"
          ],
          "assertions": [
            {
              "stream": "exitCode",
              "op": "equals",
              "value": 0
            },
            {
              "stream": "stdout",
              "op": "includes",
              "value": "25.0.3"
            }
          ],
          "cwd": "/work",
          "stdin": null,
          "status": "not-run",
          "stdout": null,
          "stderr": null,
          "exitCode": null
        },
        {
          "id": "javac-version",
          "argv": [
            "javac",
            "--version"
          ],
          "assertions": [
            {
              "stream": "exitCode",
              "op": "equals",
              "value": 0
            },
            {
              "stream": "stdout",
              "op": "includes",
              "value": "25.0.3"
            }
          ],
          "cwd": "/work",
          "stdin": null,
          "status": "not-run",
          "stdout": null,
          "stderr": null,
          "exitCode": null
        }
      ],
      "status": "not-run"
    },
    {
      "id": "compile-run",
      "title": "编译与运行",
      "notes": [
        "使用临时 /work 目录；编译没有标准输出时仍记录退出码。"
      ],
      "steps": [
        {
          "id": "compile",
          "argv": [
            "sh",
            "-c",
            "javac /work/Main.java && test -s /work/Main.class"
          ],
          "assertions": [
            {
              "stream": "exitCode",
              "op": "equals",
              "value": 0
            }
          ],
          "cwd": "/work",
          "stdin": null,
          "status": "not-run",
          "stdout": null,
          "stderr": null,
          "exitCode": null
        },
        {
          "id": "run",
          "argv": [
            "java",
            "-cp",
            "/work",
            "Main"
          ],
          "assertions": [
            {
              "stream": "exitCode",
              "op": "equals",
              "value": 0
            },
            {
              "stream": "stdout",
              "op": "includes",
              "value": "hello-java-capture"
            }
          ],
          "cwd": "/work",
          "stdin": null,
          "status": "not-run",
          "stdout": null,
          "stderr": null,
          "exitCode": null
        }
      ],
      "status": "not-run"
    },
    {
      "id": "jar",
      "title": "JAR 打包与列表",
      "notes": [
        "案例独立准备 class 文件，不依赖上一案例成功。"
      ],
      "steps": [
        {
          "id": "package",
          "argv": [
            "sh",
            "-c",
            "javac /work/Main.java && jar --create --file /work/main.jar -C /work Main.class && test -s /work/main.jar"
          ],
          "assertions": [
            {
              "stream": "exitCode",
              "op": "equals",
              "value": 0
            }
          ],
          "cwd": "/work",
          "stdin": null,
          "status": "not-run",
          "stdout": null,
          "stderr": null,
          "exitCode": null
        },
        {
          "id": "list",
          "argv": [
            "jar",
            "--list",
            "--file",
            "/work/main.jar"
          ],
          "assertions": [
            {
              "stream": "exitCode",
              "op": "equals",
              "value": 0
            },
            {
              "stream": "stdout",
              "op": "includes",
              "value": "Main.class"
            }
          ],
          "cwd": "/work",
          "stdin": null,
          "status": "not-run",
          "stdout": null,
          "stderr": null,
          "exitCode": null
        }
      ],
      "status": "not-run"
    },
