    "configs": [
      {
        "file": "scenarios/image-build.json",
        "text": "{\n  \"schemaVersion\": 1,\n  \"id\": \"image-build\",\n  \"title\": \"锁定基础镜像与多阶段构建\",\n  \"kind\": \"build\",\n  \"platform\": \"linux/amd64\",\n  \"timeoutMs\": 300000,\n  \"images\": { \"base\": { \"envFile\": \".env.versions\", \"envKey\": \"BASH_IMAGE\" } },\n  \"build\": { \"context\": \"labs/build\", \"dockerfile\": \"labs/build/Dockerfile\", \"args\": { \"BASE_IMAGE\": \"base\" } },\n  \"command\": [\"bash\", \"-c\", \"cat /message.txt; test ! -e /build-only.txt && printf 'build-only=absent\\\\n'\"],\n  \"assertions\": [\n    { \"id\": \"copied-artifact\", \"stream\": \"stdout\", \"op\": \"includes\", \"value\": \"artifact=hello-docker\" },\n    { \"id\": \"stage-boundary\", \"stream\": \"stdout\", \"op\": \"includes\", \"value\": \"build-only=absent\" }\n  ],\n  \"output\": { \"evidenceDir\": \"evidence/image-build\", \"page\": \"docs/evidence/image-build.md\" }\n}\n"
      },
      {
        "file": "labs/build/Dockerfile",
        "text": "ARG BASE_IMAGE\nFROM ${BASE_IMAGE} AS builder\nRUN printf 'artifact=hello-docker\\n' > /message.txt \\\n    && printf 'belongs to builder only\\n' > /build-only.txt\n\nFROM ${BASE_IMAGE}\nCOPY --from=builder /message.txt /message.txt\n"
